<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MauiTestApp.Converters"
             x:Class="MauiTestApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:DivideBy100Converter x:Key="DivideBy100" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmpty" />
            <converters:FirstCharConverter x:Key="FirstChar" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
