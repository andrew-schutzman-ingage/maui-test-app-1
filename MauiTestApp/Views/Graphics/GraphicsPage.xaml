<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiTestApp.ViewModels"
             xmlns:graphics="clr-namespace:MauiTestApp.Views.Graphics"
             x:Class="MauiTestApp.Views.Graphics.GraphicsPage"
             x:DataType="vm:GraphicsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,32">

            <Label Style="{StaticResource PageTitle}" Text="Graphics &amp; Animations" />
            <Label Style="{StaticResource PageDescription}"
                   Text="MAUI Graphics for drawing shapes and paths, plus built-in animation APIs." />

            <!-- Graphics Drawing -->
            <Label Style="{StaticResource SectionHeader}" Text="MAUI Graphics (IDrawable)" />
            <Frame Style="{StaticResource DemoCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource DemoLabel}"
                           Text="Custom shapes drawn with IDrawable: filled circle, gradient rectangle, star path, and bezier curve." />
                    <GraphicsView HeightRequest="180"
                                  BackgroundColor="#F8F8F8">
                        <GraphicsView.Drawable>
                            <graphics:GraphicsDrawable />
                        </GraphicsView.Drawable>
                    </GraphicsView>
                </VerticalStackLayout>
            </Frame>

            <!-- Animation Target -->
            <Label Style="{StaticResource SectionHeader}" Text="Animations" />
            <Frame Style="{StaticResource DemoCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource DemoLabel}"
                           Text="Tap buttons to trigger animations on the target element below. MAUI provides built-in extension methods for common animations." />

                    <!-- Animation target -->
                    <Frame x:Name="AnimationTarget"
                           BackgroundColor="{StaticResource Primary}"
                           CornerRadius="16"
                           WidthRequest="100"
                           HeightRequest="100"
                           HasShadow="True"
                           BorderColor="Transparent"
                           HorizontalOptions="Center">
                        <Label Text="Animate Me!"
                               TextColor="White"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="13" />
                    </Frame>

                    <Label Text="{Binding AnimationStatus}"
                           Style="{StaticResource ValueDisplay}"
                           FontSize="13" />

                    <!-- Animation buttons -->
                    <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
                        <Button Text="Fade"
                                Style="{StaticResource PrimaryButton}"
                                Margin="4"
                                Clicked="OnFadeClicked" />
                        <Button Text="Rotate"
                                Style="{StaticResource PrimaryButton}"
                                Margin="4"
                                Clicked="OnRotateClicked" />
                        <Button Text="Scale"
                                Style="{StaticResource PrimaryButton}"
                                Margin="4"
                                Clicked="OnScaleClicked" />
                        <Button Text="Translate"
                                Style="{StaticResource PrimaryButton}"
                                Margin="4"
                                Clicked="OnTranslateClicked" />
                        <Button Text="Composite"
                                BackgroundColor="{StaticResource Warning}"
                                TextColor="White"
                                CornerRadius="8"
                                FontAttributes="Bold"
                                Margin="4"
                                Clicked="OnCompositeClicked" />
                        <Button Text="Reset"
                                BackgroundColor="{StaticResource TextSecondary}"
                                TextColor="White"
                                CornerRadius="8"
                                Margin="4"
                                Clicked="OnResetClicked" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Visual States -->
            <Label Style="{StaticResource SectionHeader}" Text="Visual States" />
            <Frame Style="{StaticResource DemoCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource DemoLabel}"
                           Text="Visual State Manager changes appearance based on control state (Normal, PointerOver, Pressed, Focused)." />
                    <Button Text="Hover or Press Me" FontAttributes="Bold" CornerRadius="12" Padding="20,12">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="Scale" Value="1.0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="Scale" Value="1.05" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Scale" Value="0.95" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Button>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
