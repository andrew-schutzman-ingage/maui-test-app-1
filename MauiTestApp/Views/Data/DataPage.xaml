<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiTestApp.ViewModels"
             xmlns:models="clr-namespace:MauiTestApp.Models"
             x:Class="MauiTestApp.Views.Data.DataPage"
             x:DataType="vm:DataViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*">

        <Label Style="{StaticResource PageTitle}" Text="CollectionView Demo" Grid.Row="0" />
        <Label Style="{StaticResource PageDescription}" Grid.Row="0" Margin="16,48,16,0"
               Text="Grouped data with search filtering, pull-to-refresh, and swipe-to-delete." />

        <!-- Search Bar -->
        <SearchBar Placeholder="Filter items by name, description, or category..."
                   Text="{Binding SearchText}"
                   Margin="16,0"
                   Grid.Row="1" />

        <!-- Refreshable CollectionView -->
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     Grid.Row="2">

            <CollectionView ItemsSource="{Binding GroupedItems}"
                            IsGrouped="True"
                            SelectionMode="Single">

                <!-- Group Header -->
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:DataGroup">
                        <VerticalStackLayout Padding="16,12,16,4">
                            <Label Text="{Binding CategoryName}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <BoxView HeightRequest="2"
                                     Color="{StaticResource Accent}"
                                     Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <!-- Item Template with Swipe -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SampleDataItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="{StaticResource Danger}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DataViewModel}}, Path=DeleteItemCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame Style="{StaticResource DemoCard}" Margin="16,4">
                                <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                                    <!-- Placeholder icon circle -->
                                    <Frame BackgroundColor="{StaticResource Accent}"
                                           CornerRadius="24"
                                           WidthRequest="48"
                                           HeightRequest="48"
                                           Padding="0"
                                           HasShadow="False"
                                           BorderColor="Transparent"
                                           Grid.Column="0">
                                        <Label Text="{Binding Name, Converter={StaticResource FirstChar}}"
                                               FontSize="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource Primary}" />
                                    </Frame>

                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=White}" />
                                        <Label Text="{Binding Description}"
                                               FontSize="13"
                                               TextColor="{StaticResource TextSecondary}"
                                               LineBreakMode="TailTruncation" />
                                        <Frame Style="{StaticResource CategoryBadge}"
                                               HorizontalOptions="Start"
                                               Margin="0,4,0,0">
                                            <Label Text="{Binding Category}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Primary}" />
                                        </Frame>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Empty View -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="32">
                        <Label Text="🔍"
                               FontSize="48"
                               HorizontalOptions="Center" />
                        <Label Text="No items found"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Margin="0,8,0,0" />
                        <Label Text="Try adjusting your search terms"
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
