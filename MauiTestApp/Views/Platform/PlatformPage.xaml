<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiTestApp.ViewModels"
             x:Class="MauiTestApp.Views.Platform.PlatformPage"
             x:DataType="vm:PlatformViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,32">

            <Label Style="{StaticResource PageTitle}" Text="Platform Features" />
            <Label Style="{StaticResource PageDescription}"
                   Text="Cross-platform device and OS APIs accessible through MAUI's abstraction layer." />

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}"
                   FontSize="13"
                   TextColor="{StaticResource Success}"
                   HorizontalOptions="Center"
                   Margin="16,0" />

            <!-- Device Info -->
            <Label Style="{StaticResource SectionHeader}" Text="Device Information" />
            <Frame Style="{StaticResource DemoCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource DemoLabel}"
                           Text="Static device info retrieved via DeviceInfo API at startup." />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="16" RowSpacing="8">
                        <Label Text="Manufacturer:" FontAttributes="Bold" Grid.Row="0" Grid.Column="0" />
                        <Label Text="{Binding DeviceManufacturer}" Grid.Row="0" Grid.Column="1" />

                        <Label Text="Model:" FontAttributes="Bold" Grid.Row="1" Grid.Column="0" />
                        <Label Text="{Binding DeviceModel}" Grid.Row="1" Grid.Column="1" />

                        <Label Text="OS:" FontAttributes="Bold" Grid.Row="2" Grid.Column="0" />
                        <Label Text="{Binding OsVersion}" Grid.Row="2" Grid.Column="1" />

                        <Label Text="Idiom:" FontAttributes="Bold" Grid.Row="3" Grid.Column="0" />
                        <Label Text="{Binding DeviceIdiom}" Grid.Row="3" Grid.Column="1" />

                        <Label Text="Platform:" FontAttributes="Bold" Grid.Row="4" Grid.Column="0" />
                        <Label Text="{Binding DevicePlatform}" Grid.Row="4" Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Connectivity -->
            <Label Style="{StaticResource SectionHeader}" Text="Connectivity" />
            <Frame Style="{StaticResource DemoCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource DemoLabel}"
                           Text="Check current network access and connection type via the Connectivity API." />
                    <Label Text="{Binding ConnectivityStatus, StringFormat='Status: {0}'}"
                           Style="{StaticResource ValueDisplay}" />
                    <Button Text="Check Connectivity"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CheckConnectivityCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Clipboard -->
            <Label Style="{StaticResource SectionHeader}" Text="Clipboard" />
            <Frame Style="{StaticResource DemoCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource DemoLabel}"
                           Text="Read from and write to the system clipboard." />
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Button Text="Copy Text"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding CopyToClipboardCommand}" />
                        <Button Text="Paste"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding PasteFromClipboardCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding ClipboardText, StringFormat='Clipboard: {0}'}"
                           Style="{StaticResource ValueDisplay}"
                           FontSize="13" />
                </VerticalStackLayout>
            </Frame>

            <!-- Share -->
            <Label Style="{StaticResource SectionHeader}" Text="Share" />
            <Frame Style="{StaticResource DemoCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource DemoLabel}"
                           Text="Invoke the native share sheet to share text with other apps." />
                    <Button Text="Share Sample Text"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ShareTextCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Geolocation -->
            <Label Style="{StaticResource SectionHeader}" Text="Geolocation" />
            <Frame Style="{StaticResource DemoCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource DemoLabel}"
                           Text="Get the device's current GPS coordinates. Requires location permission." />
                    <Label Text="{Binding LocationText}"
                           Style="{StaticResource ValueDisplay}"
                           FontSize="13" />
                    <Button Text="Get Location"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding GetLocationCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Haptics / Vibration -->
            <Label Style="{StaticResource SectionHeader}" Text="Haptics" />
            <Frame Style="{StaticResource DemoCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource DemoLabel}"
                           Text="Trigger device vibration for haptic feedback." />
                    <Button Text="Vibrate (500ms)"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding VibrateCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Flashlight -->
            <Label Style="{StaticResource SectionHeader}" Text="Flashlight" />
            <Frame Style="{StaticResource DemoCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource DemoLabel}"
                           Text="Toggle the device flashlight on for 2 seconds." />
                    <Button Text="Toggle Flashlight"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ToggleFlashlightCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Preferences -->
            <Label Style="{StaticResource SectionHeader}" Text="Preferences (Key-Value Storage)" />
            <Frame Style="{StaticResource DemoCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource DemoLabel}"
                           Text="Save and read simple key-value pairs using the Preferences API (persists across app launches)." />
                    <Entry Placeholder="Enter a value to save..."
                           Text="{Binding PreferenceInput}" />
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Button Text="Save"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SavePreferenceCommand}" />
                        <Button Text="Read"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ReadPreferenceCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding PreferenceValue, StringFormat='Stored value: {0}'}"
                           Style="{StaticResource ValueDisplay}"
                           FontSize="13" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
