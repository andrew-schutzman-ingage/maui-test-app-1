@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="app-container">
    <header class="app-header">
        @if (!IsHomePage)
        {
            <button class="back-button" @onclick="GoBack">&#8592; Back</button>
        }
        <h1 class="app-title">MAUI Feature Showcase</h1>
    </header>

    <main class="app-content">
        @Body
    </main>
</div>

@code {
    private bool IsHomePage => Navigation.Uri.EndsWith("/") ||
                               Navigation.Uri.EndsWith("/index.html") ||
                               Navigation.ToBaseRelativePath(Navigation.Uri) == "";

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}
